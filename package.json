{
  "name": "sliding-puzzle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:gates && npm run checks && npm run build",
    "checks": "node scripts/check-siblings.js && node scripts/check-deletion.js && node scripts/check-worker-purity.js && node scripts/check-client-names.js --all",
    "test": "npm run check",
    "test:unit": "node --import ./scripts/tsx-hooks.js --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "test:gates": "node --import ./scripts/tsx-hooks.js --test \"gates/**/*.test.ts\" \"scripts/**/*.test.js\"",
    "mutate": "npm run mutate:puzzle && npm run mutate:game",
    "mutate:puzzle": "stryker run --mutate \"src/puzzle/**/*.ts,src/puzzle/**/*.tsx,!src/**/*.test.ts,!src/**/*.test.tsx\" --testFiles \"src/puzzle/**/*.test.ts,src/puzzle/**/*.test.tsx\" --incrementalFile reports/stryker-incremental-puzzle.json && node scripts/mutation-summary.js",
    "mutate:game": "stryker run --mutate \"src/game/**/*.ts,src/game/**/*.tsx,!src/**/*.test.ts,!src/**/*.test.tsx,!src/game/test-helpers.ts\" --testFiles \"src/game/**/*.test.ts,src/game/**/*.test.tsx\" --incrementalFile reports/stryker-incremental-game.json && node scripts/mutation-summary.js",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@react-three/fiber": "^9.8.2",
    "hono": "^4.13.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/tap-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-import-x": "^4.18.1",
    "fast-check": "^4.10.3",
    "knip": "^6.45.1",
    "miniflare": "5.20261117.0-beta",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.164.0"
  }
}
