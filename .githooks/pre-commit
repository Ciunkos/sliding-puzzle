#!/bin/sh
# Fast checks on what you are committing. CI runs the full gate; do not bypass with --no-verify.
set -e
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0
echo "pre-commit: client names"
node scripts/check-client-names.js --staged
echo "pre-commit: prettier"
echo "$staged" | grep -E '\.(ts|tsx|js|json|md|html|css|yml)$' | xargs -r npx prettier --check
code=$(echo "$staged" | grep -E '\.(ts|tsx|js)$' || true)
if [ -n "$code" ]; then
  echo "pre-commit: oxlint"
  echo "$code" | xargs npx oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error
  echo "pre-commit: typecheck"
  npx tsc --noEmit
fi
