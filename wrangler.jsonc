{
  // Stub for the later Cloudflare deploy. Not used by the local dev flow yet.
  // Replace database_id with the real D1 id, and run `wrangler d1 migrations apply` before deploying.
  "name": "sliding-puzzle",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sliding-puzzle",
      "database_id": "REPLACE_WITH_REAL_ID",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
}
